// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
}

enum FormStatus {
  DRAFT
  PUBLISHED
}

enum QuestionType {
  TEXT
  TEXTAREA
  EMAIL
  NUMBER
  PHONE
  DATE
  CHOICE
  RADIO
  CHECKBOX
  YES_NO
  RATING
  RANGE
  NPS
  ADDRESS
  FULL_NAME
}

enum WidgetPosition {
  RIGHT
  LEFT
}

enum DisplayMode {
  CLASSIC
  FOCUS
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(OWNER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
  forms    Form[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Form {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  description      String?
  welcomeText      String         @default("Hi! Mind answering a few quick questions?")
  completionText   String         @default("Thanks! Your response has been recorded.")
  themeColor       String         @default("#4f46e5")
  launcherLabel    String         @default("Chat with us")
  widgetPosition   WidgetPosition @default(RIGHT)
  submitButtonText String         @default("Submit")
  displayMode      DisplayMode    @default(CLASSIC)
  showProgress     Boolean        @default(true)
  multiPageForm    Boolean        @default(false)
  status           FormStatus     @default(DRAFT)
  publishedAt      DateTime?
  notifyOnResponse Boolean        @default(false)
  notifyEmails     String[]       @default([])

  // Templates (created by ADMIN only)
  isTemplate        Boolean @default(false)
  templateSlug      String? @unique
  templateCategory  String?
  sourceTemplateId  String?
  sourceTemplate    Form?   @relation("TemplateCopies", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  copies            Form[]  @relation("TemplateCopies")

  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  questions  Question[]
  responses  Response[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([ownerId, createdAt])
  @@index([isTemplate, status])
}

model Question {
  id         String       @id @default(cuid())
  formId     String
  form       Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  type       QuestionType
  label      String
  options    Json? // CHOICE / RADIO / CHECKBOX -> string[]
  required   Boolean      @default(true)
  order      Int
  prefillKey String?
  // Per-field appearance
  placeholder String? // input placeholder
  textColor   String? // #rrggbb - label / field text colour
  fontSize    Int? // px
  fontWeight  String? // normal | medium | semibold | bold
  fontStyle   String? // normal | italic
  answers     Answer[]

  @@index([formId, order])
}

model Response {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  sourceUrl String?
  answers   Answer[]
  createdAt DateTime @default(now())

  @@index([formId, createdAt])
}

model Answer {
  id         String   @id @default(cuid())
  responseId String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String

  @@unique([responseId, questionId])
}